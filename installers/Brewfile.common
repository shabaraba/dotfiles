# =============================================================================
# Brewfile.common - Cross-platform Homebrew packages (macOS & Linux)
# =============================================================================
# Usage:
#   brew bundle install --file=Brewfile.common
#
# This file contains packages that work on both macOS and Linux.
# =============================================================================

# =============================================================================
# Taps - Additional Homebrew Repositories
# =============================================================================
tap "shabaraba/tap"

# =============================================================================
# System Tools
# =============================================================================
# Bourne-Again SHell, a UNIX command interpreter
brew "bash"
# GNU implementation of the famous stream editor (for git hooks)
brew "gnu-sed"
# Internet file retriever
brew "wget"

# =============================================================================
# Development Tools
# =============================================================================
# Polyglot runtime manager (replaces nvm, rbenv, pyenv etc.)
brew "mise"
# Development kit for the Java programming language
brew "openjdk"
# Self-hosted Git service (local GitHub alternative)
brew "gitea"
# Gitea CLI (like gh for Gitea)
brew "tea"
# System programming language
brew "rust"

# =============================================================================
# Shell & CLI Enhancement
# =============================================================================
# Fast, configurable, shell plugin manager
brew "sheldon"
# Ambitious Vim-fork focused on extensibility and agility
brew "neovim", args: ["HEAD"]

# =============================================================================
# Container Tools
# =============================================================================
# Pack, ship and run any application as a lightweight container
brew "docker"
# Isolated development environments using Docker
brew "docker-compose"
# Container runtimes on MacOS (and Linux) with minimal setup
brew "colima"

# Development CLIs and formatters are declared in mise/config.toml.

# =============================================================================
# Language Runtimes
# =============================================================================
# Powerful, clean, object-oriented scripting language (PATH set in zsh/public/export.zsh)
brew "ruby"
